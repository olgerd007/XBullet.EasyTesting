<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- Test handlers intentionally dispatch names without declaring a complete Functions app. -->
    <NoWarn>$(NoWarn);DURABLE2003;DURABLE2004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.DurableTask" Version="1.19.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XBullet.EasyTesting.AzureFunctions\XBullet.EasyTesting.AzureFunctions.csproj" />
    <ProjectReference Include="..\..\src\XBullet.EasyTesting.Http\XBullet.EasyTesting.Http.csproj" />
    <ProjectReference Include="..\TestFunctions\TestFunctions.csproj" />
  </ItemGroup>
</Project>
