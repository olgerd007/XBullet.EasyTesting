<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>XBullet.EasyTesting.Testcontainers</PackageId>
    <Description>Scenario-scoped real infrastructure powered by Testcontainers for .NET.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.Azurite" Version="4.15.0" />
    <PackageReference Include="Testcontainers.Kafka" Version="4.15.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.15.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.15.0" />
    <PackageReference Include="Testcontainers.ServiceBus" Version="4.15.0" />
    <ProjectReference Include="..\XBullet.EasyTesting\XBullet.EasyTesting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
