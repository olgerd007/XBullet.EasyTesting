<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>XBullet.EasyTesting.Snapshots.Http</PackageId>
    <SkipPackageValidationBaseline>true</SkipPackageValidationBaseline>
    <Description>Snapshot adapters for XBullet.EasyTesting outbound HTTP stubs.</Description>
    <PackageTags>snapshot-testing;http;integration-testing;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XBullet.EasyTesting.Http\XBullet.EasyTesting.Http.csproj" />
    <ProjectReference Include="..\XBullet.EasyTesting.Snapshots\XBullet.EasyTesting.Snapshots.Core.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
